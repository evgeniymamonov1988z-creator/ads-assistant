# ---------- Общие ----------
APP_SECRET=replace-with-random-string
API_KEY=            # если заполнить, POST/PUT требуют заголовок X-API-Key
CURRENCY=RUB
DATA_DIR=./data
MOCK_MODE=0         # 1 = демо-данные без реальных API (проверить интерфейс)
CORS_ORIGINS=http://localhost:5173

# ---------- Яндекс Директ API v5 ----------
YANDEX_OAUTH_TOKEN=
YANDEX_REFRESH_TOKEN=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_AGENCY_CLIENT_LOGIN=    # логин клиента, если работаете через агентский аккаунт
YANDEX_API_URL=https://api.direct.yandex.com/json/v5
YANDEX_API_LANG=ru

# ---------- Яндекс Метрика (сайт) ----------
YM_COUNTER_ID=          # номер счётчика, например 112337107
YM_GOAL_DOWNLOAD=       # имя цели «скачивание демо» (можно пустым)

# ---------- Журнал сервера (запуски и скачивания) ----------
SERVER_LOG_PATH=        # путь к access-логу, например /home/a1306338/domains/evgeniymamonov.com/logs/access.log
DOWNLOAD_PATTERN=download_demo|/demo/|.exe

# ---------- Google Ads API ----------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_LOGIN_CUSTOMER_ID=      # MCC без дефисов, если работаете через управляющий аккаунт
GOOGLE_CUSTOMER_ID=            # рекламный аккаунт без дефисов
GOOGLE_ADS_API_VERSION=v19
